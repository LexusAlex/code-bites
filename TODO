Создать пользователя в linux
sudo useradd --create-home --shell /bin/bash --comment "crm8" crm8
sudo passwd crm8

Создание ключа
ssh-keygen -t ed25519

Настроить Имя и email в git
git config user.name "Alexsey Shmelev"
git config user.email "p1@ukcr.ru"


Удалить последний коммит вместе со всеми его изменениями:
git reset --hard HEAD~1


Проверить синтаксис конфигурации apache2
sudo apachectl -t

Проверить синтаксис конфигурации nginx
sudo nginx -t

Перезапустить nginx
sudo systemctl reload nginx

Включить сайт в nginx
sudo ln /etc/nginx/sites-available/sdo4.test.conf /etc/nginx/sites-enabled/sdo4.test.conf

Сменить владельца и группу папки
chown -R sdo4:sdo4 sdo4.test


Создать базу данных
CREATE DATABASE IF NOT EXISTS `sdo4.test` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

Создать пользователя
CREATE USER IF NOT EXISTS 'sdo4'@'%' IDENTIFIED BY '';

Выдать права
GRANT SELECT, INSERT, UPDATE, DELETE ON `sdo4.test`.* TO 'sdo4'@'%';

Проверить права
SHOW GRANTS FOR 'sdo4'@'%';

FLUSH PRIVILEGES;