{
  "name": "codebites",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A bilingual, searchable CodeBites catalog built with VitePress.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run snippets:validate && vitepress dev docs",
    "build": "npm run snippets:validate && vitepress build docs",
    "preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "snippet:new": "tsx scripts/snippet.ts new",
    "snippet:remove": "tsx scripts/snippet.ts remove",
    "snippets:list": "tsx scripts/snippet.ts list",
    "snippets:validate": "tsx scripts/snippet.ts validate"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.41",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  }
}
